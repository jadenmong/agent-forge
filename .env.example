# Mock requires no credentials. Application reads process environment only.
# This example is not loaded automatically; export before starting API.
# Never commit real credentials. No provider model is hardcoded.
OPENAI_API_KEY=
OPENAI_MODEL=
# API defaults to <repository>/data/demo.db; startup initializes schema v1.
AGENTFORGE_DB_PATH=
# Optional Vite localhost proxy API port; developer default 8000.
AGENTFORGE_API_PORT=8000
